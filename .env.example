# Active by default. Set false only for maintenance.
ORDEX_ENABLED=true

# mainnet, signet, or regtest
ORDEX_NETWORK=mainnet

# Your read-only Bitcoin Core RPC endpoint. Keep credentials outside this file.
ORDEX_CORE_RPC_URL=http://127.0.0.1:8332
ORDEX_CORE_RPC_AUTH=

# Your ord HTTP endpoint.
ORDEX_ORD_URL=http://127.0.0.1:8080

# Durable local journal path for a self-hosted gateway.
ORDEX_STORE_PATH=./data/ordex/journal.json

# Frontend: blank uses the current marketplace gateway. Set this to your own
# deployed Ordex gateway when running an independent market surface.
REACT_APP_ORDEX_API_URL=
REACT_APP_ORDEX_ENABLED=true
