---
import { OrdexExperienceShell } from '../../components/experience/OrdexExperienceShell.js';
import { TransactionSandbox } from '../../components/sandbox/TransactionSandbox.js';
import '../../styles/design-system.css';
import '../../styles/experience-tokens.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Transaction Sandbox | Ordex</title>
    <meta name="description" content="Deterministic multi-actor trading simulator for Ordex public asks, offers, swaps, and SafeOps with controlled failure injection." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <OrdexExperienceShell client:load currentRoute="/sandbox/" pageTitle="Transaction Sandbox" basePath={base}>
      <TransactionSandbox client:load basePath={base} />
    </OrdexExperienceShell>
  </body>
</html>
