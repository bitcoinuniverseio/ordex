---
import { OrdexExperienceShell } from '../../components/experience/OrdexExperienceShell.js';
import { MissionWorkspace } from '../../components/launchpad/MissionWorkspace.js';
import '../../styles/design-system.css';
import '../../styles/experience-tokens.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Active Mission Workspace | Ordex</title>
    <meta name="description" content="Step-by-step verifiable protocol mission workspace for Ordex integration, verification, and settlement." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <OrdexExperienceShell client:load currentRoute="/workspace/" pageTitle="Mission Workspace" basePath={base}>
      <MissionWorkspace client:load basePath={base} />
    </OrdexExperienceShell>
  </body>
</html>
