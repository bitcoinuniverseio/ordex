---
import { OrdexExperienceShell } from '../../components/experience/OrdexExperienceShell.js';
import { AgentBridge } from '../../components/agents/AgentBridge.js';
import '../../styles/design-system.css';
import '../../styles/experience-tokens.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agent Bridge (MCP) | Ordex</title>
    <meta name="description" content="Official MCP 2026-07-28 agent interface and interactive tool explorer for the Ordex Bitcoin protocol." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <OrdexExperienceShell client:load currentRoute="/agents/" pageTitle="Agent Bridge" basePath={base}>
      <AgentBridge client:load basePath={base} />
    </OrdexExperienceShell>
  </body>
</html>
