---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ApiPlayground } from '../../components/playground/ApiPlayground.jsx';
import { TruthLabel } from '../../components/shell/TruthLabel.jsx';
import { FeedbackWidget } from '../../components/feedback/FeedbackWidget.jsx';
import operationsData from '../../data/operations.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="API Reference & Playground: Ordex OpenAPI 3.1"
  description="Exhaustive reference of all 78 Ordex REST API endpoints with interactive execution and schema validation."
  currentNav="reference"
>
  <div style="display: flex; flex-direction: column; gap: 2.5rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
        <span class="badge badge-verification">OpenAPI 3.1</span>
        <TruthLabel level="Gateway observation" />
      </div>
      <h1 style="margin: 0 0 0.5rem 0; font-size: 2.2rem; font-weight: 800;">REST API Reference (78 Operations)</h1>
      <p style="margin: 0; font-size: 1.1rem; color: var(--color-text-secondary);">
        Interactive testing and parameter documentation for all catalog, order, offer, SafeOps, and gateway operations.
      </p>
    </div>

    {/* Embedded Playground */}
    <div>
      <h2 style="margin: 0 0 1rem 0; font-size: 1.4rem;">Interactive Operation Playground</h2>
      <ApiPlayground client:load />
    </div>

    {/* All Operations List */}
    <div class="panel">
      <div class="panel-header">
        <h2 style="margin: 0; font-size: 1.3rem;">All Contract Endpoints</h2>
        <span style="font-size: 0.85rem; color: var(--color-text-muted);">{operationsData.length} operations defined</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        {operationsData.map((op) => (
          <div
            key={op.operationId}
            id={op.operationId}
            style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: var(--color-bg-subtle); border-radius: var(--radius-md); border-left: 4px solid var(--color-border);"
          >
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <code style="font-weight: 800; color: var(--color-brand); font-size: 0.85rem;">{op.method}</code>
              <code style="font-size: 0.9rem; font-weight: 600;">{op.path}</code>
              <span style="color: var(--color-text-secondary); font-size: 0.85rem;">- {op.summary}</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span class="badge badge-observation" style="font-size: 0.7rem;">{op.tag}</span>
              <a href={`${base}/build/playground?op=${op.operationId}`} class="btn btn-secondary" style="font-size: 0.75rem; min-height: 28px; padding: 0.15rem 0.5rem;">
                Run In Playground 🚀
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <FeedbackWidget client:load route="/reference/api" heading="API Reference" />
  </div>
</BaseLayout>
