---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WizardEngine } from '../../components/wizards/WizardEngine.jsx';
import { FeedbackWidget } from '../../components/feedback/FeedbackWidget.jsx';
---

<BaseLayout
  title="Guided Workflows & Wizards: Ordex Integration Center"
  description="Interactive decision trees and validation checklists for publishing orders, batch purchases, SafeOps, and gateway operations."
  currentNav="build"
>
  <div style="display: flex; flex-direction: column; gap: 2rem;">
    <div>
      <span class="badge badge-verification">12 Guided Workflows</span>
      <h1 style="margin: 0.25rem 0 0.5rem 0; font-size: 2.2rem; font-weight: 800;">Ordex Guided Workflows</h1>
      <p style="margin: 0; font-size: 1.1rem; color: var(--color-text-secondary);">
        Interactive, schema-driven wizards that guide you through protocol choices, validate parameters, and produce actionable checklists.
      </p>
    </div>

    <WizardEngine client:load />

    <FeedbackWidget client:load route="/build/wizards" heading="Guided Workflows" />
  </div>
</BaseLayout>
