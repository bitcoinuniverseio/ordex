---
import { OrdexExperienceShell } from '../components/experience/OrdexExperienceShell.js';
import { LaunchpadEntry } from '../components/launchpad/LaunchpadEntry.js';
import '../styles/design-system.css';
import '../styles/experience-tokens.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ordex: Interactive Bitcoin Marketplace Documentation & Launchpad</title>
    <meta name="description" content="Authoritative, visual, interactive, and verifiable developer experience and mission launchpad for the Ordex Bitcoin protocol." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <OrdexExperienceShell client:load currentRoute="/" pageTitle="Ordex Launchpad" basePath={base}>
      <LaunchpadEntry client:load basePath={base} />
    </OrdexExperienceShell>
  </body>
</html>
