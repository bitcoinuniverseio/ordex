---
import BaseLayout from '../layouts/BaseLayout.astro';
import { KitGenerator } from '../components/kits/KitGenerator.jsx';
import { FeedbackWidget } from '../components/feedback/FeedbackWidget.jsx';
---

<BaseLayout
  title="Integration Kit Generator"
  description="Generate starter projects for Node.js, the browser or a fetch-handler worker, with the Ordex SDK vendored, conformance tests, pinned tools and CI."
  currentNav="build"
>
  <div style="display: flex; flex-direction: column; gap: 2rem;">
    <div>
      <h1 style="margin: 0 0 0.5rem 0; font-size: 2.2rem; font-weight: 800;">Integration Kit Generator</h1>
      <p style="margin: 0; font-size: 1.1rem; color: var(--color-text-secondary);">
        Starter projects for Node.js, the browser or a fetch-handler worker. Each one vendors the Ordex SDK, tests the capabilities you pick against the checked-in conformance vectors, pins its tools in a lockfile and runs CI on self-hosted runners.
      </p>
    </div>
    <KitGenerator client:load />
    <FeedbackWidget client:load route="/kits" heading="Integration Kit Generator" />
  </div>
</BaseLayout>
