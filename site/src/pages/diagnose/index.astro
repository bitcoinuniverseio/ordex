---
import { OrdexExperienceShell } from '../../components/experience/OrdexExperienceShell.js';
import { FailureNavigator } from '../../components/failure-navigator/FailureNavigator.js';
import '../../styles/design-system.css';
import '../../styles/experience-tokens.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Failure Navigator | Ordex</title>
    <meta name="description" content="Deterministic failure diagnosis for Ordex refusal codes, OpenAPI errors, and protocol verification rejections." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <OrdexExperienceShell client:load currentRoute="/diagnose/" pageTitle="Failure Navigator" basePath={base}>
      <FailureNavigator client:load basePath={base} />
    </OrdexExperienceShell>
  </body>
</html>
