{
  "name": "@bitcoinuniverse/ordex-sdk",
  "version": "0.1.0",
  "description": "Typed client for the Ordex gateway API, generated from the OpenAPI 3.1 contract in this repository.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "openapi-typescript ../spec/openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/purchase.test.js test/offers.test.js test/client.test.js test/runes.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3"
  }
}
