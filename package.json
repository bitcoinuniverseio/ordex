{
  "name": "ordex-documentation",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test verifier/*.test.js spec/*.test.js scripts/api-reference.test.js tests/parity/*.test.js tests/accessibility/*.test.js tests/unit/style-invariants.test.js && npx tsx --test tests/unit/*.test.js",
    "test:unit": "npx tsx --test tests/unit/*.test.js",
    "test:parity": "node --test tests/parity/*.test.js",
    "test:mcp": "npx tsx --test tests/unit/mcp-server.test.js",
    "test:security": "npx tsx --test tests/unit/security-sanitizer.test.js",
    "test:accessibility": "node --test tests/accessibility/*.test.js",
    "capture:walkthroughs": "node scripts/capture-walkthroughs.mjs",
    "test:all": "npm test && npm --prefix sdk test && node scripts/docs/conformance-cli.mjs",
    "conformance": "node scripts/docs/conformance-cli.mjs",
    "vectors": "node scripts/make-vectors.mjs",
    "coverage:check": "node scripts/docs/coverage-check.mjs",
    "site:build": "astro build",
    "site:dev": "astro dev"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "@astrojs/starlight": "0.42.0",
    "astro": "7.2.10",
    "jszip": "3.10.1",
    "pagefind": "1.5.2",
    "preact": "10.29.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "24.10.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  }
}
