        "schema": "ordex.expected-transaction-manifest/v1",
        "network": "mainnet",
        "purpose": "Transfer one inscription and pay one recipient.",
        "watchOnly": false,
        "unsignedTx": {
          "inputs": [
            {
              "txid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "vout": 0,
              "valueSats": "50000",
              "scriptPubKeyHex": "5120aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "controlledByUser": true,
              "sighashType": "DEFAULT",
              "explanation": "Your sealed inscription output, spent whole."
            },
            {
              "txid": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "vout": 1,
              "valueSats": "30000",
              "scriptPubKeyHex": "0014bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "controlledByUser": true,
              "sighashType": "DEFAULT",
              "explanation": "Cardinal change funding the fee."
            }
          ],
          "outputs": [
            {
              "scriptHex": "5120aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "valueSats": "10000",
              "role": "recipient",
              "explanation": "The buyer receives the inscription here.",
              "expectedAssets": [
                {
                  "assetType": "ORDINAL",
                  "assetId": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeei0"
                }
              ]
            },
            {
              "scriptHex": "0014bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "valueSats": "69400",
              "role": "change",
              "explanation": "Your change returns here."
            }
          ]
        },
        "fee": {
          "feeSats": "600",
          "maxFeeSats": "2000"
        },
        "digest": "43fc3ad64b9de344c0820add2f78ddc944989df365491928432b99b0237376c0"
      },
      "expected": {
        "ok": true
      }
    },
