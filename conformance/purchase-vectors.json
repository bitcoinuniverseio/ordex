        "offeredOutpoint": {
          "txid": "aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11",
          "vout": 0
        },
        "sellerPaymentScriptHex": "0014d85c2b71d0060b09c9886aeb815e50991dda124d",
        "sellerPaymentValueSats": "250000"
      },
      "transaction": {
        "inputs": [
          {
            "txid": "b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1",
            "vout": 0,
            "valueSats": "600"
          },
          {
            "txid": "b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2",
            "vout": 1,
            "valueSats": "600"
          },
          {
            "txid": "aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11aa11",
            "vout": 0,
            "valueSats": "546"
          },
          {
            "txid": "b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3",
            "vout": 2,
            "valueSats": "300000"
          }
        ],
        "outputs": [
          {
            "scriptHex": "0014aaaa0000aaaa0000aaaa0000aaaa0000aaaa0000",
            "valueSats": "1200"
          },
          {
            "scriptHex": "0014bbbb0000bbbb0000bbbb0000bbbb0000bbbb0000",
            "valueSats": "546"
          },
          {
            "scriptHex": "0014d85c2b71d0060b09c9886aeb815e50991dda124d",
