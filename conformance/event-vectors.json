    {
      "name": "a freshly signed delivery verifies",
      "kind": "webhook",
      "signing": {
        "secret": "whsec_test_secret_0123456789abcdef",
        "timestamp": 1787400000,
        "deliveryId": "evt_0001",
        "body": "{\"ok\":true}"
      },
      "verifying": {
        "secret": "whsec_test_secret_0123456789abcdef",
        "body": "{\"ok\":true}",
        "nowSeconds": 1787400100,
        "toleranceSeconds": 300
      },
      "expected": {
        "ok": true
      }
    },
    {
      "name": "a tampered body fails the digest binding",
      "kind": "webhook",
      "signing": {
        "secret": "whsec_test_secret_0123456789abcdef",
        "timestamp": 1787400000,
        "deliveryId": "evt_0001",
        "body": "{\"ok\":true}"
      },
      "verifying": {
        "secret": "whsec_test_secret_0123456789abcdef",
        "body": "{\"ok\":false}",
        "nowSeconds": 1787400100,
        "toleranceSeconds": 300
      },
      "expected": {
        "ok": false,
        "code": "SIGNATURE_INVALID"
      }
    },
    {
      "name": "a replayed delivery outside the tolerance is refused",
      "kind": "webhook",
      "signing": {
        "secret": "whsec_test_secret_0123456789abcdef",
        "timestamp": 1787400000,
        "deliveryId": "evt_0001",
        "body": "{\"ok\":true}"
      },
      "verifying": {
        "secret": "whsec_test_secret_0123456789abcdef",
        "body": "{\"ok\":true}",
        "nowSeconds": 1787401000,
        "toleranceSeconds": 300
      },
      "expected": {
        "ok": false,
        "code": "TIMESTAMP_OUT_OF_TOLERANCE"
      }
    },
    {
      "name": "a different secret fails",
      "kind": "webhook",
      "signing": {
        "secret": "whsec_test_secret_0123456789abcdef",
        "timestamp": 1787400000,
        "deliveryId": "evt_0001",
        "body": "{\"ok\":true}"
      },
      "verifying": {
        "secret": "whsec_other",
        "body": "{\"ok\":true}",
        "nowSeconds": 1787400100,
        "toleranceSeconds": 300
      },
      "expected": {
        "ok": false,
        "code": "SIGNATURE_INVALID"
      }
    },
    {
      "name": "a truncated header is refused",
      "kind": "webhook",
      "signing": {
        "secret": "whsec_test_secret_0123456789abcdef",
        "timestamp": 1787400000,
        "deliveryId": "evt_0001",
        "body": "{\"ok\":true}"
      },
      "verifying": {
        "secret": "whsec_test_secret_0123456789abcdef",
        "body": "{\"ok\":true}",
        "nowSeconds": 1787400100,
        "toleranceSeconds": 300,
        "headerOverride": "t=1787400000,v1=deadbeef"
      },
      "expected": {
        "ok": false,
        "code": "HEADER_MALFORMED"
      }
    }
  ]
}
