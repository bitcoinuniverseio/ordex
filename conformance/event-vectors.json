        "type": "ordex.order.published",
        "schemaVersion": "1",
        "network": "mainnet",
        "sequence": 0,
        "aggregate": {
          "type": "order",
          "id": "01J8ZQ0V2M3N4P5Q6R7S8T9UVW",
