{
  "version": 1,
  "description": "ordex-event/v1 envelope and webhook signature vectors.",
  "cases": [
    {
      "name": "a canonical event envelope is accepted",
      "kind": "event",
      "event": {
        "id": "0f1e2d3c-4b5a-4978-8796-a5b4c3d2e1f0",
        "type": "ordex.order.published",
        "schemaVersion": "1",
        "network": "mainnet",
        "sequence": 42000,
        "aggregate": {
          "type": "order",
          "id": "01J8ZQ0V2M3N4P5Q6R7S8T9UVW",
          "version": 1
        },
        "observedAt": "2026-09-02T12:00:00Z",
        "checkpoint": {
          "height": 900000,
          "blockHash": "0000000000000000000111111111111111111111111111111111111111111112"
        },
        "status": "canonical",
        "payload": {
          "orderId": "01J8ZQ0V2M3N4P5Q6R7S8T9UVW"
        },
        "artifactDigests": [
          "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        ],
        "traceId": "trace-1a2b3c4d"
      },
      "expected": {
        "ok": true
      }
    },
    {
      "name": "a reverted event naming the event it reverses is accepted",
      "kind": "event",
      "event": {
        "id": "1f1e2d3c-4b5a-4978-8796-a5b4c3d2e1f0",
        "type": "ordex.order.reorged",
        "schemaVersion": "1",
        "network": "mainnet",
        "sequence": 42000,
        "aggregate": {
          "type": "order",
          "id": "01J8ZQ0V2M3N4P5Q6R7S8T9UVW",
          "version": 1
        },
        "observedAt": "2026-09-02T12:00:00Z",
        "checkpoint": {
          "height": 900000,
          "blockHash": "0000000000000000000111111111111111111111111111111111111111111112"
        },
        "status": "reverted",
        "payload": {
          "orderId": "01J8ZQ0V2M3N4P5Q6R7S8T9UVW"
        },
        "artifactDigests": [
          "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        ],
        "traceId": "trace-1a2b3c4d",
        "revertedEventId": "0f1e2d3c-4b5a-4978-8796-a5b4c3d2e1f0"
      },
      "expected": {
        "ok": true
      }
    },
    {
      "name": "a reverted event without a reversed id is refused",
      "kind": "event",
      "event": {
        "id": "0f1e2d3c-4b5a-4978-8796-a5b4c3d2e1f0",
        "type": "ordex.order.published",
        "schemaVersion": "1",
        "network": "mainnet",
        "sequence": 42000,
        "aggregate": {
          "type": "order",
          "id": "01J8ZQ0V2M3N4P5Q6R7S8T9UVW",
          "version": 1
        },
        "observedAt": "2026-09-02T12:00:00Z",
        "checkpoint": {
          "height": 900000,
          "blockHash": "0000000000000000000111111111111111111111111111111111111111111112"
        },
        "status": "reverted",
        "payload": {
          "orderId": "01J8ZQ0V2M3N4P5Q6R7S8T9UVW"
        },
        "artifactDigests": [
          "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        ],
        "traceId": "trace-1a2b3c4d"
      },
      "expected": {
        "ok": false,
        "code": "REVERTED_EVENT_REQUIRED"
      }
    },
    {
      "name": "a canonical event may not name a reversed id",
