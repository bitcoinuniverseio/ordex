        },
        "authority": {
          "kind": "counterparty-core",
          "ready": true
        },
        "attached": true
      },
      "spendTx": {
        "inputs": [
          {
            "txid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "vout": 0,
            "valueSats": "15000"
          },
          {
            "txid": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            "vout": 2,
            "valueSats": "20000"
          }
        ],
        "outputs": [
          {
            "scriptHex": "0014bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "valueSats": "10000"
          },
          {
            "scriptHex": "5120aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "valueSats": "25000"
          }
        ]
      },
      "expectedOutputIndex": 1,
      "expected": {
        "ok": true,
        "carriedToIndex": 1
      }
    },
