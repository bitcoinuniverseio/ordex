    {
      "name": "a spend that carries the attachment to the planned output is accepted",
      "record": {
        "schema": "ordex.counterparty-utxo-asset/v1",
        "network": "mainnet",
        "asset": {
          "name": "RAREPEPE",
          "assetId": "137",
