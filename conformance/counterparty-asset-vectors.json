{
  "version": 1,
  "description": "Counterparty UTXO attachment record and attachment-follows vectors.",
  "cases": [
    {
      "name": "a ready attachment record is accepted",
      "record": {
        "schema": "ordex.counterparty-utxo-asset/v1",
        "network": "mainnet",
        "asset": {
          "name": "RAREPEPE",
          "assetId": "137",
          "divisible": false,
          "quantitySats": "1"
        },
        "outpoint": {
          "txid": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "vout": 2
        },
        "address": "1CounterpartyExampleAddress000000000",
        "sourceValueSats": "20000",
        "coTravelingAssets": [],
        "checkpoint": {
          "height": 900000,
          "blockHash": "0000000000000000000111111111111111111111111111111111111111111112",
          "ledgerHash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        },
        "authority": {
          "kind": "counterparty-core",
          "ready": true
        },
        "attached": true
      },
      "expected": {
        "ok": true
      }
    },
    {
      "name": "a name without the numeric asset id is refused",
